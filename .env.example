# Production on Vercel can authenticate to Vercel AI Gateway with the automatically injected OIDC token.
# No long-lived AI secret is required in production when OIDC is enabled for the project.

# Optional local development auth: use ONE of these.
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=

# Optional model override. Defaults to gpt-5.6-luna.
# For AI Gateway, either gpt-5.6-luna or openai/gpt-5.6-luna is accepted by this app.
OPENAI_MODEL=
